<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/resultadoext/db" VERSION="20261102" COMMENT="Registro de los envíos de resultados al sistema externo"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="local_resultadoext_envios" COMMENT="Un aviso al sistema externo, con los datos que se envían y su estado">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="attemptid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Intento del quiz"/>
        <FIELD NAME="quizid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Estudiante del intento"/>
        <FIELD NAME="idempotencykey" TYPE="char" LENGTH="100" NOTNULL="true" SEQUENCE="false" COMMENT="Estable entre reintentos"/>
        <FIELD NAME="gradestatus" TYPE="char" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="pending o graded"/>
        <FIELD NAME="payload" TYPE="text" NOTNULL="true" SEQUENCE="false" COMMENT="JSON que se envía, idéntico en cada reintento"/>
        <FIELD NAME="estado" TYPE="char" LENGTH="20" NOTNULL="true" SEQUENCE="false" COMMENT="pendiente, reintentando, exitoso, omitido o agotado"/>
        <FIELD NAME="intentos" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Llamadas HTTP hechas"/>
        <FIELD NAME="externalid" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false" COMMENT="Id devuelto por el sistema externo"/>
        <FIELD NAME="causa" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Causa real del último fallo u omisión"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="quizid" TYPE="foreign" FIELDS="quizid" REFTABLE="quiz" REFFIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idempotencykey" UNIQUE="true" FIELDS="idempotencykey"/>
        <INDEX NAME="attemptid" UNIQUE="false" FIELDS="attemptid"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_resultadoext_llamadas" COMMENT="Cada llamada HTTP de un envío, con lo que respondió el destino">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="envioid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="numero" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Orden de la llamada dentro del envío"/>
        <FIELD NAME="destino" TYPE="text" NOTNULL="true" SEQUENCE="false" COMMENT="URL usada en esta llamada"/>
        <FIELD NAME="httpcode" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="curlerrno" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="curlerror" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="cuerpo" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Cuerpo crudo recortado a 2000 caracteres"/>
        <FIELD NAME="exito" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="envioid" TYPE="foreign" FIELDS="envioid" REFTABLE="local_resultadoext_envios" REFFIELDS="id"/>
      </KEYS>
    </TABLE>
  </TABLES>
</XMLDB>
